# Caddy 仅监听 8443（HTTPS，tls internal 自签证书），反代到内网 app:8080。
# 容器内监听所有接口，由 docker-compose 的 127.0.0.1:8443 端口映射保证只对外暴露到本机。
# 访问地址：https://localhost:8443（需要主机名以便 tls internal 签发 localhost 证书）。
{
	admin off
	auto_https disable_redirects
}

https://localhost:8443 {
	tls internal
	reverse_proxy app:8080 {
		header_up X-Forwarded-For {remote_host}
		# 关键：关闭反向代理缓冲，保证 TTS 首片音频立即推给客户端
		flush_interval -1
	}
}
