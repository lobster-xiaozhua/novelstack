# 复制为 .env 并修改。不要把真实 secret 提交进仓库（.gitignore 已排除）。

# 首次启动时创建唯一管理员账号的初始口令（至少 8 字符）。
# 仅在 users 表为空（首次启动）时使用；之后可从 .env 中删除。
ADMIN_INITIAL_PASSWORD=please-change-this-initial-password

# Cookie Secure 标记：生产默认 true（经 Caddy 的 HTTPS 访问）。
# 仅当你不经 TLS 直接访问 app（如本机裸跑 go run 做开发调试）时才设 false。
COOKIE_SECURE=true

# 上传大小上限（MB），默认 20。
MAX_UPLOAD_MB=20

# 数据目录（容器内路径）。宿主机侧挂载为 ./data:/data。
DATA_DIR=/data

# ---- KEK（信封加密主密钥，版本化）----
# make kek 生成 secrets/kek.v1（当前）与 secrets/kek.v2（预生成，轮换时启用），
# compose 以 docker secret 只读挂载为 /run/secrets/kek_v1、/run/secrets/kek_v2。
# 轮换窗口期的写法见 README「KEK 轮换」：
#   KEK_PATH=/run/secrets/kek_v2
#   KEK_VERSION=2
#   KEK_OLD_PATHS=1=/run/secrets/kek_v1
KEK_PATH=/run/secrets/kek_v1
KEK_VERSION=1
# 旧版本 KEK 只读映射，格式 "版本=路径,版本=路径"；没有旧版本就留空
KEK_OLD_PATHS=

# 明文加密分块大小（字节），默认 1MiB。一般不需要改。
# CHUNK_SIZE=1048576

# Session 有效期（小时），默认 24。
# SESSION_TTL_HOURS=24

# 登录限流：每 IP 每分钟次数，默认 5。
# LOGIN_FAIL_PER_MINUTE=5

# ---- 第二阶段：TTS 语音朗读 ----

# Provider：off（默认，朗读接口返回 503）/ mock（演示用正弦波）/ piper（方式 A）/ openai（方式 B）
TTS_PROVIDER=mock

# 单片段最大字符数（按汉字计），默认 100
TTS_MAX_SEGMENT_CHARS=100
# 单片段合成超时（毫秒）
TTS_SEGMENT_TIMEOUT_MS=20000
# 默认 voice / speed（请求可用 ?voice= & ?speed= 覆盖，speed 范围 0.5-2.0）
TTS_VOICE=
TTS_SPEED=1.0
# 单片段音频大小上限（MB），防止引擎异常输出撑爆内存
TTS_MAX_AUDIO_MB=16

# 方式 A：本地进程桥接（piper）。需要宿主机/容器内存在 piper 可执行文件与模型。
# PIPER_BIN=/usr/local/bin/piper
# PIPER_MODEL=/models/zh_CN-huayan-medium.onnx
# PIPER_MODEL_DIR=/models        # voice 参数会映射为 <DIR>/<voice>.onnx

# 方式 B：OpenAI 兼容 HTTP 服务（compose 中 tts 服务的地址）
# TTS_HTTP_BASE_URL=http://tts:8080
# TTS_HTTP_MODEL=tts-1
# TTS_HTTP_VOICE=alloy
# 凭证二选一：环境变量或只读 secret 文件（推荐后者）
# TTS_HTTP_API_KEY=
# TTS_HTTP_API_KEY_FILE=/run/secrets/tts_api_key

# 启用 compose 的 tts profile 时使用的镜像
# TTS_IMAGE=ghcr.io/your-org/openai-compatible-tts:latest

# ---- 第三阶段：元数据检索（Meilisearch，仅索引书名/作者/标签/简介/章节标题）----

# 留空 = 不启用 Meilisearch，元数据检索自动降级为 SQLite LIKE 匹配（功能可用，无容错/前缀）
MEILI_URL=http://meilisearch:7700
# Meilisearch 主密钥：至少 16 字节；docker-compose 同时用于 meilisearch 容器
MEILI_MASTER_KEY=change-me-to-a-random-string-at-least-16-bytes
# 也可改用只读 secret 文件（优先级高于上面的环境变量）：app 侧使用
# MEILI_MASTER_KEY_FILE=/run/secrets/meili_master_key
MEILI_INDEX=books
# 启动时全量重建索引（幂等兜底）
SEARCH_SYNC_ON_START=true
SEARCH_TIMEOUT_MS=5000

# ---- 第三阶段：Legado 书源网关（路线 A）----
LEGADO_ENABLED=true
# 网关会话有效期（Legado 长期使用；与 /api 的 24h 会话完全分离）
LEGADO_SESSION_TTL_HOURS=720

# ---- 第四阶段：缓存生命周期 ----

# 缓存淘汰保护窗口（分钟）：该时间内访问过的片段不参与淘汰，避免朗读中途 404
CACHE_PROTECT_MINUTES=5
# 缓存总大小上限（MB）。0 = 不限制；仅在 make cache-prune / 控制台手工触发时生效，
# 默认不做自动淘汰（私人站写入量小，自动淘汰容易误删）
CACHE_MAX_MB=512
# 保留最近 N 天的片段（0 = 不按时间淘汰）
CACHE_KEEP_DAYS=30

# ---- 第五阶段：移动端（设备令牌 / 增量同步 / 章节预取）----

# 单次预取最多章节数（1..50）：防止一次拉整本
PREFETCH_MAX_CHAPTERS=8
# 每凭证每分钟预取请求数（1..600），令牌桶；设备与会话各自独立分桶
PREFETCH_PER_MINUTE=40
# 单次预取响应的密文上限（MB，1..64），超出提前截断并置 truncated=true
PREFETCH_MAX_MB=8
# device token 有效期（天，默认 180）；到期需重新配对/登录换发
DEVICE_TOKEN_TTL_DAYS=180

# ---- 第六阶段：每日自动备份与最小运维告警 ----

# 是否启用内置调度器（默认开启；关闭后仍可用 make backup / 控制台立即备份）
AUTO_BACKUP=true
# 每日触发时间（容器本地时区，UTC；默认 03:00）
AUTO_BACKUP_HOUR=3
AUTO_BACKUP_MINUTE=0
# 仅保留最近 N 天的自动备份包（按包名日期判断，默认 7；1..365）
BACKUP_RETAIN_DAYS=7
# 备份输出目录。compose 已把它作为独立卷挂载；本地直跑时默认 ./data/backups
BACKUP_DIR=/data/backups
# 备份口令文件（推荐：只读 secret，至少 12 字符）。留空则读 NOVELSTACK_BACKUP_PASSPHRASE。
# 备份口令与主 KEK 完全独立；不进备份包，也不进日志。
BACKUP_PASSPHRASE_FILE=
# NOVELSTACK_BACKUP_PASSPHRASE=
# 用户手动创建的 KEK 离线备份确认标记（存在即消除黄色提醒，不阻塞启动）
KEK_OFFLINE_MARKER=/data/.kek-offline-backup-ok
# 告警 webhook（可选）。触发时 POST JSON：time/level/type/summary；不含正文/查询词/token/密钥。
# 失败重试 2 次即放弃并写审计 health_webhook；无消息队列。
BACKUP_ALERT_WEBHOOK=
ALERT_COOLDOWN_MINUTES=60

# ---- 第八阶段：客户端分发 ----

# 客户端「检查更新」读取的版本号与更新说明
APP_VERSION=0.3.0
APP_CHANGELOG=
# APK 镜像地址（逗号分隔）。客户端并发对每个镜像取前 100KB 测速，选最快者下载。
APP_MIRRORS=
# 最新 APK 的 SHA-256（hex）。留空时客户端拒绝下载（不安装未校验的包）。
APP_APK_SHA256=

# ---- 第九阶段（整合版）：正文净化 / 双音色 / 阅读统计 / 数据导出 ----

# 正文明文净化规则：解密后、输出前删除命中内容（去广告）。
# 三种写法：JSON 数组、换行分隔（推荐）、";;" 分隔。正则里的逗号不会被当分隔符。
# 示例：REGEX_PURGE_RULES='请记住本站[^\n]*'
#       REGEX_PURGE_RULES='请记住本站[^\n]*
#       https?://[a-z0-9.-]*novel[^\s]*'
# 改规则后章节 ETag 会变，客户端自动重拉，无需手动清缓存。
REGEX_PURGE_RULES=

# TTS 对话音色。留空表示不启用双音色（全部用 TTS_VOICE）。
TTS_DIALOGUE_VOICE=
# 对话识别正则，必须含捕获组（组 1 为对话正文，引号本身不朗读）。
# 留空使用内置默认值，匹配 “…” "…" 「…」 『…』 四种引号，单段最多 400 字。
# 自定义示例（注意用单引号包住，避免引号被 dotenv 解析）：
# TTS_DIALOGUE_PATTERN='「([^」]{1,200})」'
TTS_DIALOGUE_PATTERN=

# 阅读统计「今天」使用的时区（IANA 名称）。默认 Asia/Shanghai；
# 用服务端时区而不是客户端时间，避免改设备时间刷出假的阅读天数。
READING_TZ=Asia/Shanghai
# 单次数据导出最多包含的书籍数（1..5000）。大库请分批导出。
EXPORT_MAX_BOOKS=200
